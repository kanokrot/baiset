{
  "name": "thai-business-documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @thai-docs/core build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.29.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "^2.1.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
